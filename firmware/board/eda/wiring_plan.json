 "steps": [
  {
   "title": "插座和排针",
   "test": "插上 ESP32，USB 线插 COM 口，串口敲 ?，能看到命令列表",
   "desc": "只焊插座，不接线。排母先插在模块上，再连模块一起放到板子上对孔焊，孔距自然对得上。焊完拔下模块。用量：ESP32 两条 22 针排母，TB6612 两条 8 针排母，MPU6050 一条 8 针排母，三个 1×6 直排针，拨码开关，电池插座，启动键（可选）。"
  },
  {
   "title": "陀螺仪",
   "test": "i 能扫到 0x68；g 手转车 90°，读数约 +90",
   "desc": "4 根线。SCL、SDA 保留同排直连。3V3 从控制板两排插座之间横穿，经过行间空隙。所有拐点按清单定位。"
  },
  {
   "title": "三个测距插座",
   "test": "插上三个 VL53L0X，i 扫到 0x30 0x31 0x32；d 读数随手挡变化",
   "desc": "7 根连续导线：3V3、GND、SCL、SDA 各用一根线从源引脚依次连接三个测距插座，中间焊点局部剥皮不断线，再接三根独立 XSHUT。四组总线保留原脚序，GPIO1 留空。右边缘的 GND 在跨线 2 处从 SCL 上方越过。"
  },
  {
   "title": "拨码和启动键",
   "test": "s 显示的拨码、按键状态和实际一致",
   "desc": "6 根线。启动键是可选的，板载 BOOT 键也能发车，可以留到最后。"
  },
  {
   "title": "电机驱动控制线",
   "test": "万用表通断档逐根量一遍：ESP32 的脚和 TB6612 的脚应该通，相邻两根不通",
   "desc": "9 根线。7 根控制线保留同排直连。3V3 与 GND 沿独立通道绕行，避开编码器信号。"
  },
  {
   "title": "电机和编码器",
   "test": "e：手往前滚轮子，读数为正、一圈约 +132 mm",
   "desc": "12 根线。两组编码器信号仍同排直连。左电机 M1 线在跨线 1 处越过右电机 M2 线，交点不焊接。两路编码器的 3V3 连接线从控制板下方绕行，避免横切编码器信号。"
  },
  {
   "title": "电源",
   "test": "接电池前先量：VBAT 和 GND 之间不通。插电池开开关，量 ESP32 的 5Vin 约 5.0 V；再拔 USB 跑 m",
   "desc": "6 根线，再加降压模块到旁边四个接点的引出线。VBAT 和电池回流 GND 沿左板边并行，5V 和输出 GND 在降压模块右侧分别上行。图中导线长度按中心线计算，裁线另留剥皮及弯折余量。"
  }
 ],
